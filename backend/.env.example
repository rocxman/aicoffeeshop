# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_coffee_shop?schema=public"

# ============================================
# APPLICATION
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRATION="7d"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_REFRESH_EXPIRATION="30d"

# ============================================
# AI / LLM CONFIGURATION
# ============================================
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
AI_TEMPERATURE="0.7"
AI_MAX_TOKENS="500"

# ============================================
# WHATSAPP BUSINESS API
# ============================================
WHATSAPP_API_KEY="your-whatsapp-api-key-here"
WHATSAPP_PHONE_ID="your-phone-id-here"
WHATSAPP_BUSINESS_ID="your-business-id-here"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-verify-token-here"

# ============================================
# PAYMENT GATEWAY (Midtrans Example)
# ============================================
MIDTRANS_SERVER_KEY="your-midtrans-server-key-here"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key-here"
MIDTRANS_IS_PRODUCTION=false

# ============================================
# CLOUD STORAGE (Optional)
# ============================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="ai-coffee-shop-uploads"

# ============================================
# REDIS (For caching & sessions)
# ============================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ============================================
# EMAIL SERVICE (Optional)
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@aicoffeeshop.com"

# ============================================
# FRONTEND URL (for CORS)
# ============================================
FRONTEND_URL="http://localhost:3001"

# ============================================
# MONITORING & LOGGING
# ============================================
SENTRY_DSN=""
LOG_LEVEL="debug"
